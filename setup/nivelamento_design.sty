\ProvidesPackage{nivelamento_design}[2026/09/30 Identidade visual e variaveis institucionais do Nivelamento ITEC]

% Garante que pacotes essenciais de cor e strings estejam disponíveis neste módulo
\RequirePackage{xcolor}
\RequirePackage{xstring}

% ----------------------------------------------------------------------
% PALETA DE CORES BASE DO NIVELAMENTO
% ----------------------------------------------------------------------
% Define as cores institucionais de cada eixo para uso global
\definecolor{colorNiv}{HTML}{006b8f}% Nivelamento
\definecolor{colorPC}{HTML}{2357A0} % Pré-Cálculo
\definecolor{colorPG}{HTML}{FBBC04} % Programação
\definecolor{colorQI}{HTML}{15CBC7} % Química
\definecolor{colorBIO}{HTML}{0D8440}% Biologia
\definecolor{colorIB}{HTML}{4B2BA1} % Informática Básica
\definecolor{colorFI}{HTML}{B20A32} % Física
