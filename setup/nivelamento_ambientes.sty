% ----------------------------------------------------------------------
% FORMATAÇÃO DE CÓDIGOS FONTE E TERMINAL
% ----------------------------------------------------------------------
\RequirePackage{listings} % ADICIONADO: Faltava no preâmbulo original

% Cores auxiliares exclusivas para blocos de código
\definecolor{codegreen}{rgb}{0,0.6,0}
\definecolor{codeblue}{rgb}{0,0.42,0.56}
\definecolor{codegray}{rgb}{0.5,0.5,0.5}
\definecolor{codepurple}{rgb}{0.58,0,0.82}

% Estilo 1: Código Fonte padrão
\lstdefinestyle{codigo}{
    backgroundcolor=\color{gray!10},   
    commentstyle=\color{codegreen},
    keywordstyle=\color{codeblue},
    numberstyle=\tiny\color{codegray},
    stringstyle=\color{codepurple},
    basicstyle=\fontsize{10}{10}\ttfamily,
    breakatwhitespace=false,         
    breaklines=true,                 
    captionpos=t,                    
    keepspaces=true,                 
    numbers=left,                    
    numbersep=5pt,                  
    showspaces=false,                
    showstringspaces=false,
    showtabs=false,
    tabsize=2,
    literate= % Suporte a caracteres acentuados omitido aqui por brevidade (mantenha o original)
}

% Estilo 2: Terminal / Prompt de comando
\lstdefinestyle{terminal}{
    backgroundcolor=\color{black},   
    commentstyle=\color{white},
    keywordstyle=\color{white},
    numbers=none, 
    stringstyle=\color{white},
    basicstyle=\fontsize{8}{10}\ttfamily,
    breaklines=true,                 
    keepspaces=true,                 
    tabsize=2
}
\lstset{style=codigo} % Define 'codigo' como o comportamento padrão

% Macro para código inline no meio do texto
\newcommand{\inlinecode}[1]{%
    \tcbox[on line, boxrule=0pt, top=0.05cm, bottom=-0.01cm, arc=0.25cm, colback=main, colframe=white, width=auto, left=1pt, right=1pt]{\color{white}\footnotesize\texttt{\textbf{#1}}}%
}

% ----------------------------------------------------------------------
% CAIXAS DE TEXTO SEMÂNTICAS (BLINDAGEM)
% ----------------------------------------------------------------------
\RequirePackage[most]{tcolorbox}
\RequirePackage{fontawesome}
\RequirePackage{varwidth}

% REGRA PARA A EQUIPE: É proibido usar \begin{tcolorbox} diretamente.
% Os redatores devem usar APENAS os ambientes semânticos abaixo.

% Ambiente: Caixa de Atenção / Importante
\newtcolorbox{boxAtencao}[1][]{
    enhanced,
    boxrule=0pt,
    frame hidden,
    borderline west={4pt}{0pt}{main-dark},
    colback=main!10!white,
    coltitle=main-dark,
    fonttitle=\bfseries,
    title={\faExclamationTriangle\quad #1},
    attach title to upper=\par\vspace{0.5em},
}

% Ambiente: Exercício Resolvido
\newtcolorbox{boxResolvido}[1][Exemplo Resolvido]{
    enhanced,
    colback=white,
    colframe=main,
    fonttitle=\bfseries,
    title={\faPencil\quad #1},
    arc=1mm,
}

% ----------------------------------------------------------------------
% FORMATAÇÃO DE TÍTULOS E SUMÁRIO
% ----------------------------------------------------------------------
\RequirePackage{titlesec}
\RequirePackage{tocloft}

% Criação de níveis mais profundos de subseção (subsubsubsection)
\titleclass{\subsubsubsection}{straight}[\subsection]
\newcounter{subsubsubsection}[subsubsection]
\renewcommand\thesubsubsubsection{\thesubsubsection.\arabic{subsubsubsection}}

\titleformat{\subsubsubsection}
  {\normalfont\normalsize\bfseries}{\thesubsubsubsection}{1em}{}
\titlespacing*{\subsubsubsection}
  {0pt}{3.25ex plus 1ex minus .2ex}{1.5ex plus .2ex}

\setcounter{secnumdepth}{4}
\setcounter{tocdepth}{4}

% ----------------------------------------------------------------------
% FORMATAÇÃO DE SEÇÕES (IDENTIDADE VISUAL DO NIVELAMENTO)
% ----------------------------------------------------------------------

% Estilo para \section: Número em destaque num bloco colorido e linha de fechamento
\titleformat{\section}
  {\color{main-dark}\normalfont\Large\bfseries} % Cor e fonte do título
  {\colorbox{main}{\color{white}\hspace{0.2em}\thesection\hspace{0.2em}}} % Número da seção em um bloco sólido
  {1em} % Distância entre o bloco do número e o texto
  {}
  [\vspace{0.3ex}{\color{main}\titlerule[1.5pt]}] % Linha horizontal espessa abaixo do título

% Estilo para \subsection: Texto na cor base do eixo, mais limpo para não pesar a leitura
\titleformat{\subsection}
  {\color{main}\normalfont\large\bfseries}
  {\thesubsection}
  {1em}
  {}

% Ajuste de espaçamento vertical (respiro) ao redor dos títulos
\titlespacing*{\section}{0pt}{4ex plus 1ex minus .2ex}{2ex plus .2ex}
\titlespacing*{\subsection}{0pt}{3ex plus 1ex minus .2ex}{1.5ex plus .2ex}

