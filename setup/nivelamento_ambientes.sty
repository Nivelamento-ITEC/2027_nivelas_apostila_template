}

\DeclareTColorBox[auto counter, number within=section]{exercicio}{ O{} O{} }{
    estiloQuestao,
    title={\faPencil\quad Exercício \thetcbcounter\ifx&#1&\else\ - #1\fi},
    label={#2}
}

\DeclareTColorBox[use counter from=exercicio]{desafio}{ O{} O{} }{
    estiloQuestao,
    borderline west={2.5pt}{0pt}{red!80!black},
    coltitle=red!80!black,
    title={\faTrophy\quad Desafio \thetcbcounter\ifx&#1&\else\ - #1\fi},
    label={#2}
}

