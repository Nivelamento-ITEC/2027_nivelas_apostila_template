% ----------------------------------------------------------------------
% PLOTAGENS E GRÁFICOS (PGFPLOTS)
% ----------------------------------------------------------------------
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}

% Configuração base unificada para todos os gráficos do Nivelamento.
% A equipe de redação não deve usar ambientes separados para cada tipo de gráfico.
% Eles devem usar \begin{axis}[estiloGraficoBase, opções locais extras...]
\pgfplotsset{
    estiloGraficoBase/.style={
        axis lines=middle,
        xlabel={$x$},
        ylabel={$y$},
        grid=major,
        legend pos=south west,
        samples=250,
        width=0.7\linewidth,
        height=0.7\linewidth,
        every axis x label/.style={at={(ticklabel* cs:1.05)}, anchor=west},
        every axis y label/.style={at={(ticklabel* cs:1.05)}, anchor=south}
    },
    estiloTrigonometrico/.style={
        estiloGraficoBase,
        xlabel={$x$ (rad)},
        xtick={-6.28318, -4.71238, -3.14159, -1.57079, 0, 1.57079, 3.14159, 4.71238, 6.28318},
        xticklabels={$-2\pi$,$-\frac{3\pi}{2}$,$-\pi$,$-\frac{\pi}{2}$,$0$, $\frac{\pi}{2}$, $\pi$, $\frac{3\pi}{2}$, $2\pi$}
    }
}

% Ambiente único para plotagem simples e direta para padronizar as apostilas
\newenvironment{graficoNiv}[1][]{
    \begin{center}
    \begin{tikzpicture}
        \begin{axis}[estiloGraficoBase, #1]
}{
        \end{axis}
    \end{tikzpicture}
    \end{center}
}