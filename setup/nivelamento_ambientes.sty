% ----------------------------------------------------------------------
% AMBIENTES SEMÂNTICOS DE CONTEÚDO (COM CONTADORES UNIFICADOS)
% ----------------------------------------------------------------------
% Todos os ambientes acadêmicos seguem o contador da seção atual.

% O comando \DeclareTColorBox usa a sintaxe { O{} O{} } para criar dois parâmetros opcionais
\DeclareTColorBox[auto counter, number within=section]{exemplo}{ O{} O{} }{
    estiloNivelamento,
    colback=white,
    colframe=main,
    title={\faLightbulbO\quad Exemplo \thetcbcounter\ifx&#1&\else\ - #1\fi},
